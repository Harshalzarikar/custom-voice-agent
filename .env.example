# Vocal-Voice Environment Variables
# Copy this file to .env and fill in your actual API keys. Do NOT commit .env to GitHub.

# development | production
ENV=development

# Browser origin allowed to call the API. Comma-separate more than one.
# Production must be the real https origin, for example https://vocal-frontend.onrender.com
FRONTEND_URL=http://localhost:5173

# Frontend build target. Vite only reads variables that start with VITE_.
VITE_API_URL=http://localhost:5000

# Reviewer phrases ("simulate delay", "simulate duplicate") stay on locally.
# Set false on any public deploy.
ENABLE_DEMO_TRIGGERS=true

# Optional. Defaults to the backend directory. The database file is vocal.db in this folder.
# Set DATABASE_URL to a Postgres URL when the API and the worker run on different machines.
# DATABASE_URL=postgresql://user:password@host:5432/vocal
# SESSION_SECRET is required when ENV=production. Locally a secret is generated in DATA_DIR.
# It also encrypts patient phone numbers. Keep the same value or those numbers cannot be read.
# The API refuses to boot in production when this is missing.
# SESSION_SECRET=
# Timezone used for "today", slot cutoffs and the clock the agent speaks. Defaults to Asia/Kolkata.
# HOSPITAL_TZ=Asia/Kolkata
# One live voice call at a time on this worker. Raise this only when more workers are running.
# MAX_ACTIVE_CALLS=1
# Set true only when a reverse proxy overwrites X-Forwarded-For. The last hop is the client.
# TRUST_PROXY=false
# DATA_DIR=
# Production hosts should stay at 1. Raise this only on a machine with spare RAM.
# WORKER_IDLE_PROCESSES=1

# LiveKit WebRTC Configuration
LIVEKIT_URL=wss://your-livekit-url.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# AI Provider Keys
GROQ_API_KEY=gsk_your_groq_api_key
DEEPGRAM_API_KEY=your_deepgram_api_key
TAVILY_API_KEY=tvly-your_tavily_api_key
